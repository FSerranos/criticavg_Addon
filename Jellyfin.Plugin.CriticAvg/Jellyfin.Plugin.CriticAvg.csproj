<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One source, two builds (set by the GitHub workflow):
      Jellyfin 12.x   -> -p:JellyfinVersion=12.0.0   -p:TargetFramework=net10.0
      Jellyfin 10.11  -> -p:JellyfinVersion=10.11.11 -p:TargetFramework=net9.0
  -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
           <JfFramework Condition="'$(JfFramework)' == ''">net10.0</JfFramework>
       <TargetFramework>$(JfFramework)</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.CriticAvg</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.CriticAvg</AssemblyName>
    <Version Condition="'$(Version)' == ''">1.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin itself provides these at runtime, so they are compile-only. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
